set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ENV{RK_CROSS_PREFIX})
 message(FATAL_ERROR "Set RK_CROSS_PREFIX to the vendor SDK Linux compiler prefix, including path and trailing dash")
endif()
set(CMAKE_C_COMPILER "$ENV{RK_CROSS_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "$ENV{RK_CROSS_PREFIX}g++")
if(DEFINED ENV{RK_SYSROOT})
 set(CMAKE_SYSROOT "$ENV{RK_SYSROOT}")
 set(CMAKE_FIND_ROOT_PATH "$ENV{RK_SYSROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
