[Unit]
Description=RK3588 vehicle monitor SOFTWARE SIMULATION
After=network.target
ConditionPathExists=/opt/vehicle-monitor/etc/enable-simulation

[Service]
Type=simple
ExecStart=/opt/vehicle-monitor/vmctl supervise
TimeoutStopSec=8
KillMode=control-group
Restart=no

[Install]
WantedBy=multi-user.target
